          "name": "Vector Get Health Status",
          "request": {
            "name": "Vector Get Health Status",
            "description": {
              "content": "Returns the health status of the running Vector instance. Returns HTTP 200 with {\"ok\": true} when Vector is running normally. Returns HTTP 200 with {\"ok\": false} when Vector is shutting down. Used by load balancers and Kubernetes liveness/readiness probes.",
              "type": "text/plain"
            },
